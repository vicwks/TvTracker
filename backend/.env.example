# Copie ce fichier en ".env" et remplis les valeurs

# Base de données MySQL
# Avec Docker (docker-compose.yml), DB_HOST / DB_USER / DB_PASSWORD sont surchargés automatiquement.
# En local avec WAMP : DB_HOST=localhost, DB_USER=root, DB_PASSWORD= (vide par défaut)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tv_tracker

# API TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Port du serveur backend
PORT=5000

# Secret utilisé pour signer les sessions de connexion : 32 caractères minimum, obligatoire.
# Le backend refuse de démarrer sans lui. Exemple de génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cookie de session "Secure" (HTTPS uniquement). Laisser vide ou false en local (HTTP).
COOKIE_SECURE=false
